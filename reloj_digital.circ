<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <lib desc="file#contador_mod60.circ" name="7"/>
  <lib desc="file#contador_mod24.circ" name="8"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
    <a name="tickmain" val="half"/>
  </options>
  <mappings>
    <tool lib="6" map="Button2" name="Menu Tool"/>
    <tool lib="6" map="Button3" name="Menu Tool"/>
    <tool lib="6" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Text Tool"/>
    <tool lib="6" name="Color Picker Tool"/>
    <tool lib="6" name="Hand Tool"/>
    <tool lib="6" name="Move Tool"/>
    <tool lib="6" name="Selection Tool"/>
    <tool lib="6" name="Wiring Tool"/>
    <tool lib="6" name="Deletion Tool"/>
    <tool lib="6" name="Rectangle Select Tool"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisimEvolution"/>
    <a name="circuit" val="main"/>
    <a name="clocked" val="true"/>
    <a name="clocks" val=""/>
    <a name="clockspeed" val="1.0"/>
    <a name="label" val=""/>
    <a name="labelfont" val="SansSerif,12"/>
    <a name="labelloc" val="east"/>
    <a name="negate" val="false"/>
    <a name="simulateVerilog" val="0"/>
    <a name="simulateVerilogFile" val=""/>
    <a name="tickCountdown" val=""/>
    <a name="tickCountdownEnabled" val="false"/>
    <comment>Reloj Digital con Flip-Flops
Estructura principal que integra los contadores
de segundos, minutos y horas</comment>
    <!-- Definición de pines de entrada/salida -->
    <comp lib="5" loc="(100,150)" name="Clock"/>
    <comp lib="5" loc="(100,200)" name="Button">
      <a name="label" val="Reset"/>
    </comp>
    <comp lib="5" loc="(900,150)" name="Hex Digit Display"/>
    <comp lib="5" loc="(900,200)" name="Hex Digit Display"/>
    <comp lib="5" loc="(900,250)" name="Hex Digit Display"/>
    
    <!-- Etiquetas -->
    <comp lib="5" loc="(850,150)" name="Label">
      <a name="text" val="Horas"/>
    </comp>
    <comp lib="5" loc="(850,200)" name="Label">
      <a name="text" val="Minutos"/>
    </comp>
    <comp lib="5" loc="(850,250)" name="Label">
      <a name="text" val="Segundos"/>
    </comp>
    
    <!-- Contadores modulares (subcircuitos) -->
    <comp lib="7" loc="(350,150)" name="main">
      <a name="label" val="Contador Segundos"/>
    </comp>
    <comp lib="7" loc="(350,250)" name="main">
      <a name="label" val="Contador Minutos"/>
    </comp>
    <comp lib="8" loc="(350,350)" name="main">
      <a name="label" val="Contador Horas"/>
    </comp>
    
    <!-- Lógica de carry y reset -->
    <comp lib="1" loc="(500,180)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="Carry a Minutos"/>
    </comp>
    <comp lib="1" loc="(500,280)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="Carry a Horas"/>
    </comp>
    <comp lib="1" loc="(650,320)" name="AND Gate">
      <a name="inputs" val="3"/>
      <a name="label" val="Reset Global"/>
    </comp>
    
    <!-- Conexiones de cables -->
    <wire from="(100,150)" to="(200,150)"/>
    <wire from="(100,200)" to="(200,200)"/>
    <wire from="(200,150)" to="(350,150)"/>
    <wire from="(200,200)" to="(650,320)"/>
    
  </circuit>
  
  <!-- Subcircuito: Contador módulo 60 -->
  <circuit name="contador_mod60">
    <a name="appearance" val="logisimEvolution"/>
    <a name="circuit" val="contador_mod60"/>
    <a name="clocked" val="true"/>
    <a name="label" val="Contador Mod 60"/>
    <a name="labelloc" val="east"/>
    
    <!-- Pines -->
    <appear>
      <circ anchor="east" facing="west" label="Carry Out"/>
      <rect fill="none" height="200" stroke="black" width="100" x="0" y="0"/>
    </appear>
    
    <!-- Flip-Flops JK en cascada (6 bits) -->
    <comp lib="4" loc="(100,100)" name="J-K Flip-Flop">
      <a name="label" val="FF0 (LSB)"/>
    </comp>
    <comp lib="4" loc="(150,100)" name="J-K Flip-Flop">
      <a name="label" val="FF1"/>
    </comp>
    <comp lib="4" loc="(200,100)" name="J-K Flip-Flop">
      <a name="label" val="FF2"/>
    </comp>
    <comp lib="4" loc="(250,100)" name="J-K Flip-Flop">
      <a name="label" val="FF3"/>
    </comp>
    <comp lib="4" loc="(300,100)" name="J-K Flip-Flop">
      <a name="label" val="FF4"/>
    </comp>
    <comp lib="4" loc="(350,100)" name="J-K Flip-Flop">
      <a name="label" val="FF5 (MSB)"/>
    </comp>
    
    <!-- Decodificador para detectar 59 -->
    <comp lib="1" loc="(500,120)" name="AND Gate">
      <a name="inputs" val="6"/>
      <a name="label" val="Detectar 59"/>
    </comp>
    
    <!-- Reset síncrono -->
    <comp lib="0" loc="(550,150)" name="Output">
      <a name="label" val="Carry"/>
    </comp>
    
  </circuit>
  
  <!-- Subcircuito: Contador módulo 24 -->
  <circuit name="contador_mod24">
    <a name="appearance" val="logisimEvolution"/>
    <a name="circuit" val="contador_mod24"/>
    <a name="clocked" val="true"/>
    <a name="label" val="Contador Mod 24"/>
    <a name="labelloc" val="east"/>
    
    <!-- Pines -->
    <appear>
      <circ anchor="east" facing="west" label="Carry Out"/>
      <rect fill="none" height="200" stroke="black" width="100" x="0" y="0"/>
    </appear>
    
    <!-- Flip-Flops JK en cascada (5 bits) -->
    <comp lib="4" loc="(100,100)" name="J-K Flip-Flop">
      <a name="label" val="FF0 (LSB)"/>
    </comp>
    <comp lib="4" loc="(150,100)" name="J-K Flip-Flop">
      <a name="label" val="FF1"/>
    </comp>
    <comp lib="4" loc="(200,100)" name="J-K Flip-Flop">
      <a name="label" val="FF2"/>
    </comp>
    <comp lib="4" loc="(250,100)" name="J-K Flip-Flop">
      <a name="label" val="FF3"/>
    </comp>
    <comp lib="4" loc="(300,100)" name="J-K Flip-Flop">
      <a name="label" val="FF4 (MSB)"/>
    </comp>
    
    <!-- Decodificador para detectar 23 -->
    <comp lib="1" loc="(400,120)" name="AND Gate">
      <a name="inputs" val="5"/>
      <a name="label" val="Detectar 23"/>
    </comp>
    <comp lib="1" loc="(380,140)" name="NOT Gate">
      <a name="label" val="NOT FF2"/>
    </comp>
    
    <!-- Carry Out -->
    <comp lib="0" loc="(450,150)" name="Output">
      <a name="label" val="Carry"/>
    </comp>
    
  </circuit>
  
</project>
