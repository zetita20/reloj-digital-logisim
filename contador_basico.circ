<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
    <a name="tickmain" val="half"/>
  </options>
  <mappings>
    <tool lib="6" map="Button2" name="Menu Tool"/>
    <tool lib="6" map="Button3" name="Menu Tool"/>
    <tool lib="6" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Text Tool"/>
    <tool lib="6" name="Color Picker Tool"/>
    <tool lib="6" name="Hand Tool"/>
    <tool lib="6" name="Move Tool"/>
    <tool lib="6" name="Selection Tool"/>
    <tool lib="6" name="Wiring Tool"/>
    <tool lib="6" name="Deletion Tool"/>
    <tool lib="6" name="Rectangle Select Tool"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisimEvolution"/>
    <a name="circuit" val="main"/>
    <a name="clocked" val="true"/>
    <a name="clocks" val=""/>
    <a name="clockspeed" val="1.0"/>
    <a name="label" val=""/>
    <a name="labelfont" val="SansSerif,12"/>
    <a name="labelloc" val="east"/>
    <a name="negate" val="false"/>
    <a name="simulateVerilog" val="0"/>
    <a name="simulateVerilogFile" val=""/>
    <a name="tickCountdown" val=""/>
    <a name="tickCountdownEnabled" val="false"/>
    <comp lib="5" loc="(100,100)" name="Clock">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="5" loc="(100,150)" name="Button">
      <a name="label" val="RESET"/>
    </comp>
    <comp lib="4" loc="(200,100)" name="J-K Flip-Flop">
      <a name="label" val="FF1"/>
    </comp>
    <comp lib="4" loc="(300,100)" name="J-K Flip-Flop">
      <a name="label" val="FF2"/>
    </comp>
    <comp lib="4" loc="(400,100)" name="J-K Flip-Flop">
      <a name="label" val="FF3"/>
    </comp>
    <comp lib="5" loc="(500,100)" name="LED">
      <a name="label" val="Q1"/>
    </comp>
    <comp lib="5" loc="(500,120)" name="LED">
      <a name="label" val="Q2"/>
    </comp>
    <comp lib="5" loc="(500,140)" name="LED">
      <a name="label" val="Q3"/>
    </comp>
    <wire from="(100,100)" to="(150,100)"/>
    <wire from="(150,100)" to="(150,200)"/>
    <wire from="(150,200)" to="(200,100)"/>
    <wire from="(150,200)" to="(300,100)"/>
    <wire from="(150,200)" to="(400,100)"/>
    <wire from="(220,100)" to="(280,100)"/>
    <wire from="(320,100)" to="(380,100)"/>
    <wire from="(220,100)" to="(500,100)"/>
    <wire from="(320,100)" to="(500,120)"/>
    <wire from="(420,100)" to="(500,140)"/>
  </circuit>
</project>
