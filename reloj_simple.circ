<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
    <a name="tickmain" val="half"/>
  </options>
  <mappings>
    <tool lib="6" map="Button2" name="Menu Tool"/>
    <tool lib="6" map="Button3" name="Menu Tool"/>
    <tool lib="6" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Text Tool"/>
    <tool lib="6" name="Color Picker Tool"/>
    <tool lib="6" name="Hand Tool"/>
    <tool lib="6" name="Move Tool"/>
    <tool lib="6" name="Selection Tool"/>
    <tool lib="6" name="Wiring Tool"/>
    <tool lib="6" name="Deletion Tool"/>
    <tool lib="6" name="Rectangle Select Tool"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisimEvolution"/>
    <a name="circuit" val="main"/>
    <a name="clocked" val="true"/>
    <a name="label" val="Reloj Digital"/>
    <a name="labelfont" val="SansSerif,16"/>
    <a name="labelloc" val="north"/>
    
    <!-- RELOJ -->
    <comp lib="5" loc="(50,60)" name="Clock"/>
    
    <!-- BOTON RESET -->
    <comp lib="5" loc="(50,110)" name="Button">
      <a name="label" val="Reset"/>
    </comp>
    
    <!-- TITULO -->
    <comp lib="5" loc="(400,20)" name="Text">
      <a name="text" val="RELOJ DIGITAL 24 HORAS"/>
    </comp>
    
    <!-- DISPLAYS PARA HORAS -->
    <comp lib="5" loc="(600,80)" name="7-Segment Display"/>
    <comp lib="5" loc="(700,80)" name="7-Segment Display"/>
    
    <!-- DISPLAYS PARA MINUTOS -->
    <comp lib="5" loc="(600,160)" name="7-Segment Display"/>
    <comp lib="5" loc="(700,160)" name="7-Segment Display"/>
    
    <!-- DISPLAYS PARA SEGUNDOS -->
    <comp lib="5" loc="(600,240)" name="7-Segment Display"/>
    <comp lib="5" loc="(700,240)" name="7-Segment Display"/>
    
    <!-- SEPARADORES -->
    <comp lib="5" loc="(650,120)" name="Text">
      <a name="text" val=":"/>
      <a name="font" val="SansSerif,20"/>
    </comp>
    <comp lib="5" loc="(650,200)" name="Text">
      <a name="text" val=":"/>
      <a name="font" val="SansSerif,20"/>
    </comp>
    
    <!-- ETIQUETAS -->
    <comp lib="5" loc="(550,80)" name="Text">
      <a name="text" val="Horas"/>
    </comp>
    <comp lib="5" loc="(550,160)" name="Text">
      <a name="text" val="Minutos"/>
    </comp>
    <comp lib="5" loc="(550,240)" name="Text">
      <a name="text" val="Segundos"/>
    </comp>
    
    <!-- FLIP-FLOPS PARA SEGUNDOS (0-59) -->
    <comp lib="4" loc="(150,80)" name="J-K Flip-Flop">
      <a name="label" val="SS0"/>
    </comp>
    <comp lib="4" loc="(200,80)" name="J-K Flip-Flop">
      <a name="label" val="SS1"/>
    </comp>
    <comp lib="4" loc="(250,80)" name="J-K Flip-Flop">
      <a name="label" val="SS2"/>
    </comp>
    <comp lib="4" loc="(300,80)" name="J-K Flip-Flop">
      <a name="label" val="SS3"/>
    </comp>
    <comp lib="4" loc="(350,80)" name="J-K Flip-Flop">
      <a name="label" val="SS4"/>
    </comp>
    <comp lib="4" loc="(400,80)" name="J-K Flip-Flop">
      <a name="label" val="SS5"/>
    </comp>
    
    <!-- FLIP-FLOPS PARA MINUTOS (0-59) -->
    <comp lib="4" loc="(150,160)" name="J-K Flip-Flop">
      <a name="label" val="MM0"/>
    </comp>
    <comp lib="4" loc="(200,160)" name="J-K Flip-Flop">
      <a name="label" val="MM1"/>
    </comp>
    <comp lib="4" loc="(250,160)" name="J-K Flip-Flop">
      <a name="label" val="MM2"/>
    </comp>
    <comp lib="4" loc="(300,160)" name="J-K Flip-Flop">
      <a name="label" val="MM3"/>
    </comp>
    <comp lib="4" loc="(350,160)" name="J-K Flip-Flop">
      <a name="label" val="MM4"/>
    </comp>
    <comp lib="4" loc="(400,160)" name="J-K Flip-Flop">
      <a name="label" val="MM5"/>
    </comp>
    
    <!-- FLIP-FLOPS PARA HORAS (0-23) -->
    <comp lib="4" loc="(150,240)" name="J-K Flip-Flop">
      <a name="label" val="HH0"/>
    </comp>
    <comp lib="4" loc="(200,240)" name="J-K Flip-Flop">
      <a name="label" val="HH1"/>
    </comp>
    <comp lib="4" loc="(250,240)" name="J-K Flip-Flop">
      <a name="label" val="HH2"/>
    </comp>
    <comp lib="4" loc="(300,240)" name="J-K Flip-Flop">
      <a name="label" val="HH3"/>
    </comp>
    <comp lib="4" loc="(350,240)" name="J-K Flip-Flop">
      <a name="label" val="HH4"/>
    </comp>
    
    <!-- CONEXIONES DE CLOCK -->
    <wire from="(50,60)" to="(80,60)"/>
    <wire from="(80,60)" to="(80,300)"/>
    <wire from="(80,80)" to="(150,80)"/>
    <wire from="(80,160)" to="(150,160)"/>
    <wire from="(80,240)" to="(150,240)"/>
    <wire from="(80,80)" to="(80,160)"/>
    <wire from="(80,160)" to="(80,240)"/>
    
    <!-- CONEXIONES EN CASCADA - SEGUNDOS -->
    <wire from="(165,80)" to="(185,80)"/>
    <wire from="(215,80)" to="(235,80)"/>
    <wire from="(265,80)" to="(285,80)"/>
    <wire from="(315,80)" to="(335,80)"/>
    <wire from="(365,80)" to="(385,80)"/>
    
    <!-- CONEXIONES EN CASCADA - MINUTOS -->
    <wire from="(165,160)" to="(185,160)"/>
    <wire from="(215,160)" to="(235,160)"/>
    <wire from="(265,160)" to="(285,160)"/>
    <wire from="(315,160)" to="(335,160)"/>
    <wire from="(365,160)" to="(385,160)"/>
    
    <!-- CONEXIONES EN CASCADA - HORAS -->
    <wire from="(165,240)" to="(185,240)"/>
    <wire from="(215,240)" to="(235,240)"/>
    <wire from="(265,240)" to="(285,240)"/>
    <wire from="(315,240)" to="(335,240)"/>
    
    <!-- SALIDA A DISPLAYS -->
    <wire from="(165,80)" to="(600,80)"/>
    <wire from="(215,80)" to="(700,80)"/>
    <wire from="(165,160)" to="(600,160)"/>
    <wire from="(215,160)" to="(700,160)"/>
    <wire from="(165,240)" to="(600,240)"/>
    <wire from="(215,240)" to="(700,240)"/>
    
  </circuit>
</project>
